; Remich's external-weather test project (Remich issue #19).
;
; A second, deliberately tiny project beside `godot/`. The committed fixture in
; `godot/` initializes the one weather node in STAND-IN mode, which is test
; behaviour and must stay exactly as it is for its own acceptance. This
; project proves the PRODUCTION seam — the same one `RemichWeather` class, the
; same one Rust channel, initialized for the external driver — without
; changing anything about the fixture.
;
; It creates exactly ONE native weather object, in external mode, and drives it
; from this file's own probe. It has no stand-in, no schedule, no clock of its
; own and no weather policy: the values published below are plain test numbers
; standing in for what an external driver decides, so Remich stays
; independently testable with no dependency on that driver.

config_version=5

[application]

config/name="RemichExternalWeather"
config/description="Remich's production-seam weather proof (Remich issue #19): one RemichWeather in external mode, one externally decided snapshot, read back through the existing readers."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

ExternalWeatherProbe="*res://external_weather_probe.gd"

[shader_globals]

grengewald_wind={
"type": "vec4",
"value": Vector4(1, 0, 0, 0)
}
