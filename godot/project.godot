; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RemichTest"
config/description="Remich's own Godot test project (docs/PLAN.md, phase 1 step 1)."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Marker="*res://marker.gd"
ScorerProbe="*res://scorer_probe.gd"
WorldClock="*res://world_clock.gd"
Weather="*res://weather.gd"
DayProbe="*res://day_probe.gd"
ClockProbe="*res://clock_probe.gd"
BridgeProbe="*res://bridge_probe.gd"
WeatherProbe="*res://weather_probe.gd"
SaveProbe="*res://save_probe.gd"

[shader_globals]

grengewald_wind={
"type": "vec4",
"value": Vector4(1, 0, 0, 0)
}
